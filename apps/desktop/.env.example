# Copy to apps/desktop/.env and fill with your signing credentials.

# macOS codesign identity (run `security find-identity -v -p codesigning` to inspect)
CSC_NAME="Example Inc. (ABCDE12345)"
# Optional: path/URL to .p12 bundle if you do not use the keychain (file://, https://, etc.)
CSC_LINK=
CSC_KEY_PASSWORD=
# Set to false to prevent electron-builder from picking another identity automatically.
CSC_IDENTITY_AUTO_DISCOVERY=false

# Apple notarization / App Store Connect
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=

# Publishing credentials are deliberately absent: releases are built, signed,
# and published by CI, which supplies GH_TOKEN / GH_REPO to the deployer itself.
# Nothing run from this directory uploads anything.

# The auto-updater is ON by default in packaged builds. Set this to a falsy
# value (0/false/no/off) to disable update checks on a packaged app, e.g. for QA.
# Dev builds never run the updater regardless of this value.
# CHRO_ENABLE_AUTO_UPDATER=false
