{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chro",
  "version": "0.1.33",
  "identifier": "com.chro-ai.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:vite",
    "devUrl": "http://localhost:3400",
    "beforeBuildCommand": "bun run tauri:icons && bun run build:vite",
    "frontendDist": "../dist-vite"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [],
    "externalBin": [
      "binaries/chro-server"
    ],
    "category": "Productivity",
    "shortDescription": "Chro desktop app",
    "longDescription": "Chro is an AI-powered productivity desktop application.",
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": [
          "English"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "chro"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3MjlFRDgxRjUzNEJDREIKUldUYnZEVDFnZTBwaDd6VDhLVWowaDJ5QjJoZEZPbkdscGU3dlJQSXk1MWVYdTNmRDdRN3ZyVjUK",
      "endpoints": [
        "https://github.com/n-asuy/chro/releases/latest/download/latest-{{target}}.json"
      ]
    }
  }
}
