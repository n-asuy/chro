{
  "compilerOptions": {
    "target": "es2022",
    "module": "Node16",
    "lib": ["es2022", "dom"],
    "rootDir": "./",
    "outDir": "../dist-electron",
    "strict": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "electron"]
  },
  "include": ["./**/*.ts"]
}
