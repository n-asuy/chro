{
  "name": "@chro/desktop",
  "version": "0.1.25",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -p \"[{name}]\" -n server,vite,electron \"bun run dev:server\" \"bun run dev:vite\" \"bun run dev:electron\"",
    "dev:web": "concurrently -p \"[{name}]\" -n server,vite \"bun run dev:server\" \"bun run dev:vite\"",
    "dev:web:scan": "concurrently -p \"[{name}]\" -n server,vite,scan \"bun run dev:server\" \"bun run dev:vite\" \"wait-on http://localhost:3400 && npx react-scan@latest http://localhost:3400\"",
    "dev:web:perf": "concurrently -p \"[{name}]\" -n server,vite \"bun run dev:server:perf\" \"bun run dev:vite:perf\"",
    "dev:server": "cargo run --manifest-path ../../crates/server/Cargo.toml --bin chro-server -- --port 4310",
    "dev:server:perf": "cross-env CHRO_PERF_DIR=../../log/performance cargo run --manifest-path ../../crates/server/Cargo.toml --bin chro-server -- --port 4310 --perf",
    "build:native:filesystem": "node ./scripts/build-native-filesystem.mjs",
    "dev:vite": "bun run build:native:filesystem && vite",
    "dev:vite:perf": "cross-env CHRO_PERF=1 CHRO_PERF_DIR=../../log/performance bun run build:native:filesystem && vite",
    "dev:electron": "bun run build:electron && wait-on -i 2000 http://localhost:3400 && cross-env ELECTRON_DEV_URL=http://localhost:3400 electron .",
    "build": "vite build && bun run build:electron",
    "build:vite": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "cross-env NODE_ENV=production electron .",
    "package": "bun ./scripts/deployer.ts package",
    "package:mac:nosign": "bun ./scripts/deployer.ts package --skip-sign -- --mac",
    "package:win:nosign": "bun ./scripts/deployer.ts package --skip-sign -- --win",
    "package:release": "bun ./scripts/deployer.ts release",
    "package:release:nosign": "bun ./scripts/deployer.ts release --skip-sign",
    "package:legacy": "bun run build && electron-builder",
    "release": "bun ./scripts/deployer.ts tag"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.19.1",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@git-diff-view/file": "^0.0.36",
    "@git-diff-view/react": "^0.0.36",
    "@headlessui/react": "^2.2.9",
    "@lezer/markdown": "^1.6.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-router": "^1.157.16",
    "@tanstack/react-virtual": "^3.13.18",
    "electron-updater": "^6.6.2",
    "framer-motion": "11.15.0",
    "katex": "^0.16.27",
    "lezer-markdown-obsidian": "^0.0.3",
    "lucide-react": "0.441.0",
    "mermaid": "^11.12.2",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^9.2.1",
    "remark-gfm": "^4.0.1",
    "rfc6902": "^5.1.2",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.8.2",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@tanstack/router-plugin": "^1.157.16",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "38.2.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.4",
    "vite": "^7.3.1",
    "vitest": "^4.1.0",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.chro-ai.desktop",
    "productName": "Chro",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "n-asuy",
      "repo": "chro-ai"
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "assets/logo/logo_chro_symbol_bg_rounded.png",
    "files": [
      "dist-electron/**/*",
      "assets/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-vite",
        "to": "vite-app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../crates/server/target/release",
        "to": "rust-server",
        "filter": [
          "chro-server",
          "chro-server.exe"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "binaries": [
        "Contents/Resources/rust-server/chro-server"
      ],
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Chro Auth",
            "CFBundleURLSchemes": [
              "chro"
            ]
          }
        ]
      },
      "notarize": true
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
