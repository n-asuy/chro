{
  "name": "chro",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": ["packages/*", "apps/*", "tooling/*"],
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo dev --parallel",
    "dev:web:perf": "bun run --filter=@chro/desktop dev:web:perf",
    "dev:api": "turbo dev --filter=@chro/api",
    "dev:cli": "turbo dev --filter=@chro/cli",
    "dev:desktop": "turbo dev --filter=@chro/desktop",
    "dev:mobile": "turbo dev --filter=@chro/mobile",
    "setup:mobile": "bun run --filter=@chro/mobile setup",
    "test": "turbo test --parallel",
    "package:local:cli": "bun run --filter=@chro/cli package:local",
    "package:release:cli": "bun run --filter=@chro/cli package:release",
    "format": "biome format --write .",
    "lint": "turbo lint && bun lint:repo",
    "lint:repo": "bunx sherif@latest -i tailwindcss",
    "lint:repo:fix": "bunx sherif@latest -i tailwindcss --fix",
    "oss:check": "bun tooling/scripts/check-oss-sanitization.mjs",
    "licenses": "bun run licenses:js && bun run licenses:rust",
    "licenses:js": "bun tooling/scripts/check-js-licenses.mjs",
    "licenses:rust": "bun tooling/scripts/check-rust-licenses.mjs",
    "typecheck": "turbo typecheck",
    "codemap:session": "node tooling/scripts/generate-session-codemap.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@cloudflare/workers-types": "^4.20250618.0",
    "@daytonaio/sdk": "0.22.1",
    "@opentelemetry/winston-transport": "^0.14.0",
    "@playwright/test": "1.59.1",
    "@t3-oss/env-nextjs": "^0.11.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "aws4fetch": "^1.0.20",
    "caniuse-lite": "^1.0.30001727",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.44.2",
    "electron-updater": "^6.6.2",
    "fancy-ansi": "^0.1.3",
    "license-checker": "^25.0.1",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
    "react-xarrows": "^2.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss-animate": "^1.0.7",
    "turbo": "^2.5.8",
    "typescript": "^5.5.4"
  },
  "packageManager": "bun@1.1.26",
  "overrides": {
    "get-stream": "5.2.0",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2"
  },
  "dependencies": {
    "posthog-js": "^1.360.0",
    "react-force-graph-2d": "^1.29.1"
  }
}
